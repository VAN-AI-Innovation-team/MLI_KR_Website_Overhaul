# Local development only. Fill in the actual web OAuth client ID and approved
# policy versions before testing real Google sign-in.
APP_ORIGIN="http://127.0.0.1:8787"
ALLOW_INSECURE_LOCAL_COOKIES="true"
GOOGLE_CLIENT_ID=""
TERMS_VERSION=""
PRIVACY_VERSION=""

# Comma-separated verified Google subjects, not email addresses.
ADMIN_GOOGLE_SUBJECTS=""
# SHA-256 of a random 32+ character admin code. Keep the actual code private.
ADMIN_CODE_SHA256=""

# Stage 3: public intake. Set the approved intake policy separately from the
# membership privacy policy. Never expose the secret key in a client bundle.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
INTAKE_PRIVACY_VERSION=""
# Optional: blank disables marketing opt-in.
MARKETING_CONSENT_VERSION=""
# Optional: approved retention period in days (1..36500); blank stores NULL.
INTAKE_RETENTION_DAYS=""
